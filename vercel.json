{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{db/**,vendor/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__path=/api/$1"
    }
  ]
}
